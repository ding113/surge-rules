# Static assets only (install page & Surge scripts). Build artifacts, updated-at.svg and
# build-meta.json are served from R2 by worker.js; their Content-Type / Cache-Control are
# stored on the objects by the release workflow's R2 upload step.
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/*.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=1800, stale-while-revalidate=86400

/install.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=600
