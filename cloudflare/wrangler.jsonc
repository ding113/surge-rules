{
  "name": "surge-rules",
  "account_id": "199c831f9865b14c47f24f2f8b0c8ce6",
  "main": "worker.js",
  "compatibility_date": "2026-04-01",
  "routes": [
    {
      "pattern": "rule-set.ygxz.de",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  // Hourly release dispatch (UTC). Replaces GitHub's best-effort `schedule` trigger.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "GH_REPO": "ding113/surge-rules",
    "GH_WORKFLOW": "release.yml",
    "GH_REF": "main"
  },
  "observability": {
    "enabled": true
  }
}
